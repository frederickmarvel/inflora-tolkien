ENV=dev
SERVICE_NAME=tolkien
VERSION=0.1.0-dev
LOG_LEVEL=debug
LOG_FORMAT=text
HTTP_ADDR=:8080

DB_DRIVER=postgres
DB_DSN=postgres://inflora:dev@localhost:5432/inflora?sslmode=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=inflora-events
NATS_CONSUMER_GROUP=tolkien

SESSION_TTL_HOURS=720
OVERLAY_TOKEN_TTL_HOURS=2160
LOGIN_RATE_LIMIT_PER_MIN=5
LOGIN_LOCKOUT_THRESHOLD=3

INTERNAL_API_KEY=change-me-in-production
